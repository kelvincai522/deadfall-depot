#usda 1.0
(
    doc = "Asset probe: Warehouse01 at true scale, corrected dome orientation, corrected rendermode token."
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    # Warehouse01 is authored in centimetres (metersPerUnit 0.01). USD does NOT
    # rescale on reference, so cm assets need an explicit 0.01 scale to land in
    # this metre-based stage.
    def Xform "Warehouse" (
        prepend references = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Assets/ArchVis/Industrial/Buildings/Warehouse/Warehouse01.usd@
    )
    {
        double3 xformOp:scale = (0.01, 0.01, 0.01)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    # Dome: for a Z-up stage a latlong HDRI maps correctly with no X rotation.
    # Only spin about Z to aim the sun/horizon features.
    def DomeLight "Sky"
    {
        float inputs:intensity = 1200
        asset inputs:texture:file = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Assets/Skies/Storm/approaching_storm_4k.hdr@
        token inputs:texture:format = "latlong"
        double3 xformOp:rotateXYZ = (0, 0, 40)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 4500
        float inputs:angle = 0.6
        color3f inputs:color = (1.0, 0.83, 0.62)
        double3 xformOp:rotateXYZ = (0, -58, 125)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    # Interior eye-level camera. Z-up convention: identity looks down -Z, so
    # rotateX = 90 pitches to the horizon, then rotateZ yaws (heading).
    def Camera "ProbeInterior"
    {
        float focalLength = 20
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.05, 10000)
        double3 xformOp:translate = (-25, -22, 1.7)
        double3 xformOp:rotateXYZ = (88, 0, -40)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "ProbeExterior"
    {
        float focalLength = 24
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.05, 10000)
        double3 xformOp:translate = (-70, -80, 12)
        double3 xformOp:rotateXYZ = (78, 0, -38)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def Scope "Render"
{
    def RenderProduct "PROBE_INT"
    {
        rel camera = </World/ProbeInterior>
        rel orderedVars = [</Render/PROBE_INT/LdrColor>]
        int2 resolution = (1600, 900)
        def RenderVar "LdrColor"
        {
            string sourceName = "LdrColor"
        }
    }

    def RenderProduct "PROBE_EXT"
    {
        rel camera = </World/ProbeExterior>
        rel orderedVars = [</Render/PROBE_EXT/LdrColor>]
        int2 resolution = (1600, 900)
        def RenderVar "LdrColor"
        {
            string sourceName = "LdrColor"
        }
    }
}
