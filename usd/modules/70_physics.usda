    # ---------------------------------------------------------------------
    # 3. COLLISION GROUPS
    # ---------------------------------------------------------------------
    def Scope "PhysicsCollisionGroups"
    {
        # the map shell -- collided, never simulated
        def PhysicsCollisionGroup "CG_StaticWorld"
        {
            prepend rel collection:colliders:includes = [
                </World/Terrain>,
                </World/Architecture>
            ]
        }
        # the 149 solver-settled dynamic props
        def PhysicsCollisionGroup "CG_SettledDebris"
        {
            prepend rel collection:colliders:includes = [
                </World/Physics/SettledDebris>
            ]
        }
        # roll-up curtains and barrels, the dock levellers and the sliding gate leaf
        def PhysicsCollisionGroup "CG_Doors"
        {
            prepend rel collection:colliders:includes = [
                </World/Architecture/Warehouse/Facade/WestDoor0_bottomrail>,
                </World/Architecture/Warehouse/Facade/WestDoor0_coil>,
                </World/Architecture/Warehouse/Facade/WestDoor2_bottomrail>,
                </World/Architecture/Warehouse/Facade/WestDoor2_coil>,
                </World/Architecture/Warehouse/Facade/WestDoor3_bottomrail>,
                </World/Architecture/Warehouse/Facade/WestDoor3_coil>,
                </World/Architecture/Warehouse/Facade/EastDoor1_bottomrail>,
                </World/Architecture/Warehouse/Facade/EastDoor1_coil>,
                </World/Architecture/Warehouse/Facade/EastDoor3_bottomrail>,
                </World/Architecture/Warehouse/Facade/EastDoor3_coil>,
                </World/Architecture/Warehouse/Facade/HeroGate_bottomrail>,
                </World/Architecture/Warehouse/Facade/HeroGate_coil>,
                </World/Architecture/PerimeterFence/Gate/Leaf>,
                </World/Architecture/Dock/Leveller1>,
                </World/Architecture/Dock/Leveller3>
            ]
        }
        # crane hoist drum, hook block, hook, and the guard-hut boom
        def PhysicsCollisionGroup "CG_Rigging"
        {
            prepend rel collection:colliders:includes = [
                </World/Architecture/GuardHut/Barrier_beam>,
                </World/Architecture/GantryCrane/HookBlock>,
                </World/Architecture/GantryCrane/Hook>,
                </World/Architecture/GantryCrane/TrolleyDrum>
            ]
        }
    }

