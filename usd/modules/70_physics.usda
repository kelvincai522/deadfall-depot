                    vector3f physics:velocity = (0, 0, 0)
                    vector3f physics:angularVelocity = (0, 0, 0)
                    bool physics:collisionEnabled = 1
                    uniform token physics:approximation = "convexHull"
                    float physics:mass = 3
                    point3f physics:centerOfMass = (0, 0, 0.117)
                    rel physics:simulationOwner = </World/PhysicsScene>
                    rel material:binding:physics = </World/PhysicsMaterials/PM_Cardboard>
                }
            }
        }

        # -----------------------------------------------------------------
        # 5. ARTICULATION
        #
        # A roll-up shutter is a PRISMATIC pair (curtain lifts, barrel spins),
        # not a revolute hinge, and the compound gate measured off 20_architecture
        # is a SLIDING gate on a 15.8 m track, not a swinging one - so those are
        # authored as prismatic + revolute pairs. The revolute joints in this map
        # are the six shutter barrels, the two dock levellers, the boom barrier
        # and the crane hoist drum.
        # -----------------------------------------------------------------
        def Scope "Joints"
        {
            # WestDoor0: curtain lifts 3.79 m in its guides before it is fully coiled
            def PhysicsPrismaticJoint "WestDoor0_Lift"
            {
                rel physics:body0 = </World/Architecture/Warehouse/Facade/WestDoor0_guideA>
                rel physics:body1 = </World/Architecture/Warehouse/Facade/WestDoor0_bottomrail>
                uniform token physics:axis = "Z"
                float physics:lowerLimit = 0
                float physics:upperLimit = 3.790
                point3f physics:localPos0 = (-37.85, 35.615, -0.05)
                point3f physics:localPos1 = (-37.85, 35.615, -0.05)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                bool physics:collisionEnabled = 0
                bool physics:jointEnabled = 1
                float physics:breakForce = 26000
            }
            # WestDoor0: the shutter barrel, free to spin about Y
            def PhysicsRevoluteJoint "WestDoor0_Barrel"
            {
                rel physics:body0 = </World/Architecture/Warehouse/Facade/WestDoor0_hood>
                rel physics:body1 = </World/Architecture/Warehouse/Facade/WestDoor0_coil>
