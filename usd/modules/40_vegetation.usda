            class Xform "ScrubBirchDry" (
                doc = "A drought-stressed birch, half its leaves gone brown. Late summer on a hardstanding kills saplings; this is what that looks like, and it is a brown that reads as DYING, not as autumn - the chroma is a third of a fall atlas. Asset Gray_Birch (3.332 m native), height band 1.75-2.80 m."
                prepend references = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Assets/Vegetation/Trees/Gray_Birch.usd@
