                    asset inputs:reflectionroughness_texture = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/vMaterials_2/Ground/textures/mulch_multi_R_rough_G_ao_B_height.jpg@
                    float inputs:reflection_roughness_texture_influence = 0.65
                    float inputs:reflection_roughness_constant = 0.92
                    color3f inputs:diffuse_tint = (1.020, 0.840, 0.700)
                    float inputs:albedo_brightness = 0.6307
                    float inputs:albedo_desaturation = 0.24
                    float inputs:albedo_add = -0.0550
                    float inputs:metallic_constant = 0.06
                    float inputs:specular_level = 0.40
                    asset inputs:detail_normalmap_texture = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/vMaterials_2/Metal/textures/iron_pitted_steel_norm.jpg@
                    uniform float inputs:detail_bump_factor = 0.9000
                    float2 inputs:detail_texture_scale = (20.83333, 20.83333)
                    float inputs:detail_texture_rotate = 59.0
                    bool inputs:project_uvw = 1
                    bool inputs:world_or_object = 1
                    float2 inputs:texture_scale = (8.18891, 2.50969)
                    float2 inputs:texture_translate = (0.11, 0.53)
                    float inputs:texture_rotate = 17.0
