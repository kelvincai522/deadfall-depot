    over "Architecture"
    {
        over "Warehouse"
        {
            # ---------------------------------------------------------------
            # THE HOST WALL — Warehouse01's own bundled looks
            # ---------------------------------------------------------------
            # The south elevation is two materials in one frame: 20_architecture's
            # 24 recladding sheets (A_Corr*/A_CorrFade*/A_Galv*, pinned to one
            # family by _mat_tune's LOOK_SPEC) laid over the ASSET's corrugated
            # cladding. Unifying only the sheets leaves them patching a wall
            # that is a different colour and a different value, so the host has
            # to join the same family or the fix does not land.
            #
            # 20_architecture already tunes these looks; this layer is stronger,
            # so these opinions win. Nothing in 20_architecture.usda is edited —
            # materials are this module's, and the override is authored here.
            #
            # MEASURED on HERO_ESTABLISH: sunlit host cladding rendered at sRGB
            # luma 0.761 and the sheets at 0.806 — a near-white building with no
            # headroom for a 5.5 deg key to rake across. Every tint below is the
            # authored tint's own luminance x 0.70, redirected onto the family's
            # grey-green axis (r,g,b = 0.965, 1.015, 0.945 of luma for cladding;
            # 0.955, 1.005, 0.985 for steel). Level and hue only — brightness,
            # desaturation, maps and normals are left exactly as authored.
            over "Warehouse01"
            {
                over "Looks"
                {
                    # ONE look is overridden here, and deliberately only one.
                    # `tools/_mat_idpass.py --asset-only` recolours the asset's
                    # bundled materials one at a time and renders; it showed
                    # YellowPaint owns the corrugated field of the SOUTH
                    # ELEVATION, while WhitePaint_A/B, Metal_A and
                    # GlossyMetal_A/B/C are mullions, flashings, the roof and
                    # the INSIDE faces of the same envelope.
                    #
                    # Retinting that second group cost more than it bought:
                    # INTERIOR_AISLE went cool_pixel_frac 0.277 -> 0.213 warm,
                    # then -> 0.144 cool-but-brighter, i.e. two attempts, both
                    # through the 0.25 floor, on a shot whose only cool source
                    # is the sky through the doors. They are left exactly as
                    # 20_architecture authored them.
                    over "YellowPaint"
                    {
                        over "Shader"
                        {
                            color3f inputs:diffuse_tint = (0.2825, 0.2742, 0.2468)
                        }
                    }
                }
            }

            over "Facade"
            {
                over "Bay0_U0_pane"
                {
                    rel material:binding = </World/Looks/A_Glass_1>
                }

                over "Bay0_U1_pane"
                {
                    rel material:binding = </World/Looks/A_Glass_2>
                }

                over "Bay0_U2_pane"
                {
                    rel material:binding = </World/Looks/A_Glass_0>
                }

                over "Bay0_cill"
                {
                    rel material:binding = </World/Looks/A_Concrete_1>
                }

                over "Bay0_cillU"
                {
                    rel material:binding = </World/Looks/A_Concrete_4>
                }

                over "Bay1_L0_ply0"
                {
