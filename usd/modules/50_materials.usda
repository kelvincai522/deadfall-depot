                float inputs:albedo_brightness = 0.1859
                float inputs:albedo_desaturation = 0.42
                float inputs:albedo_add = -0.0495
                float inputs:specular_level = 0.42
                asset inputs:detail_normalmap_texture = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/vMaterials_2/Metal/textures/iron_pitted_steel_norm.jpg@
                uniform float inputs:detail_bump_factor = 0.9000
                float2 inputs:detail_texture_scale = (12.00000, 12.00000)
                float inputs:detail_texture_rotate = 3.0
                bool inputs:project_uvw = 1
                bool inputs:world_or_object = 1
                float2 inputs:texture_scale = (1.75000, 0.21875)
                float2 inputs:texture_translate = (0.11, 0.07)
                float inputs:texture_rotate = 0.0
                bool inputs:enable_opacity = 1
                bool inputs:enable_opacity_texture = 1
                asset inputs:opacity_texture = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/vMaterials_2/Concrete/textures/spongy_concrete_weathered_mask_wet.png@
