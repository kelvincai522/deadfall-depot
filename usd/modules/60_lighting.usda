            def RectLight "Bridge_Underside"
            {
                float inputs:width = 2.2
                float inputs:height = 26.0
                color3f inputs:color = (1.0000, 0.5800, 0.2700)
                float inputs:intensity = 22000000.0
                float inputs:exposure = 0
                float inputs:diffuse = 1.0
                float inputs:specular = 0.85
                bool inputs:normalize = 1
                custom bool visibleInPrimaryRay = 0
                double3 xformOp:translate = (25.9, -3.0, 5.65)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def RectLight "Trestle_West"
            {
                float inputs:width = 3.5
                float inputs:height = 3.5
                color3f inputs:color = (1.0000, 0.4600, 0.1400)
                float inputs:intensity = 6000000.0
                float inputs:exposure = 0
                float inputs:diffuse = 1.0
                float inputs:specular = 0.85
                bool inputs:normalize = 1
                custom bool visibleInPrimaryRay = 0
                double3 xformOp:translate = (-30.0, 3.5, 5.0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def RectLight "YardMast_EastApron"
            {
                float inputs:width = 6.0
                float inputs:height = 5.0
                color3f inputs:color = (1.0000, 0.5800, 0.2700)
                float inputs:intensity = 15000000.0
