                    float3[] extent = [(47.2917, 33.7014, 7.6353), (58.4952, 37.7791, 11.5992)]
                    int[] faceVertexCounts = [4]
                    int[] faceVertexIndices = [0, 1, 2, 3]
                    rel material:binding = </World/Lighting/Volumetrics/Looks/L_ShaftSoft>
                    point3f[] points = [(47.5657, 33.8011, 11.5992), (47.2917, 33.7014, 9.3228), (58.1728, 37.6618, 7.6353), (58.4952, 37.7791, 10.3134)]
                    uniform token subdivisionScheme = "none"
                }
            }
        }
    }

    # Fixture-emission bindings. 60_lighting sublayers ABOVE both
    # 20_architecture and 50_materials, so these overrides win without
    # either file being edited. Only lenses 20_architecture already bound
    # emissive are rebound - the dead units stay dead.
    over "Architecture"
    {
        over "Warehouse"
        {
            over "Warehouse01"
            {
                over "SM_Lamp_A1" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Lighting/Looks/M_LampSodium>
                }
            }

            over "Facade"
            {
                over "WallPack0_lens" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Lighting/Looks/M_LensSodium>
                }

                over "WallPack1_lens" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Lighting/Looks/M_LensSodium>
                }

                over "WallPack2_lens" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Lighting/Looks/M_LensMercury>
                }

                over "WallPack4_lens" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Lighting/Looks/M_LensSodium>
                }

                over "WallPack5_lens" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Lighting/Looks/M_LensSodium>
                }
            }
        }

        over "DockCanopy"
        {
            over "Sodium0_lens" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Lighting/Looks/M_LensSodium>
            }

            over "Sodium2_lens" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Lighting/Looks/M_LensSodium>
            }

            over "Sodium3_lens" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Lighting/Looks/M_LensSodium>
            }

            over "Sodium5_lens" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Lighting/Looks/M_LensSodium>
            }
        }
    }
}
